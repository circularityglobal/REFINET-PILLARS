# The domain this Pillar answers on. Point an A (and AAAA) record at this
# server before starting: Caddy needs it to obtain the TLS certificate.
PILLAR_DOMAIN=pillar.example.com
PILLAR_NAME=Example Pillar

# Optional: the app this Pillar belongs to. APP_ORIGIN may call the gateway
# and the bridge from a browser; APP_DOMAIN is listed in the domain proof.
APP_ORIGIN=https://example.com
APP_DOMAIN=example.com

# Optional: encrypt the Pillar's key at rest. Needed again on every start.
PILLAR_KEY_PASSWORD=

# PillarStaking on XDC (chain 50). Leave empty until the contract is live.
STAKING_CHAIN_ID=50
STAKING_CONTRACT=
# 1 = replicate only from peers staked on-chain and bound to their stake
REQUIRE_STAKE=0
