[Unit]
Description=REFInet Pillar - Sovereign Gopher Mesh Node
Documentation=https://github.com/circularityglobal/REFINET-PILLARS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=refinet
Group=refinet
WorkingDirectory=/opt/refinet
ExecStart=/usr/bin/python3 /opt/refinet/pillar.py
# An encrypted key is unlocked at startup from REFINET_PID_PASSWORD; there is
# nobody at a terminal to type it. Put it in a root-only file:
#   printf 'REFINET_PID_PASSWORD=...\n' > /etc/refinet/pillar.env
#   chmod 600 /etc/refinet/pillar.env
# A plaintext key needs none of this.
EnvironmentFile=-/etc/refinet/pillar.env
Restart=on-failure
RestartSec=10
WatchdogSec=300

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/refinet/.refinet
PrivateTmp=yes

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
